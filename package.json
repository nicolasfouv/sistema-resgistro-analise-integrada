{
  "name": "sistema-de-rastreio-de-fauna",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:types\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:types": "npm run watch --workspace=srf-backend",
    "dev:backend": "npm start --workspace=srf-backend",
    "dev:frontend": "npm run dev --workspace=srf-frontend",
    "build:shared": "npm run build --workspace=srf-shared-types",
    "build": "npm run build:shared && npm run build --workspace=srf-backend && npm run build --workspace=srf-frontend"
  },
  "workspaces": [
    "srf-backend",
    "srf-frontend",
    "srf-shared-types"
  ],
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "mysql2": "^3.22.5",
    "prisma": "^6.4.1"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/client@6.4.1": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/engines@6.4.1": true,
    "prisma@6.19.3": true,
    "prisma@6.4.1": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
